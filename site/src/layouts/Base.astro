---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { ORGANIZATION_JSONLD, ORGANIZATION_REF } from '../lib/schema';
import { ATTRIBUTION_JS, CONSENT_DEFAULT_JS, GTM_ID, TRACK_JS, gtmLoaderJs } from '../lib/tracking';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  type?: 'website' | 'article';
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description = 'AI agent skills to operate your Shopify store with extended capabilities. Works with Claude, Claude Code, Claude Cowork, Cursor, Cline, Copilot, and Gemini CLI.',
  ogImage = 'https://skills.40rty.ai/40rty-logo.png',
  type = 'website',
  jsonLd,
} = Astro.props;

const base = import.meta.env.BASE_URL;
const canonicalUrl = Astro.url.href;
const siteName = 'Shopify Admin Skills';
const siteUrl = 'https://skills.40rty.ai';

const defaultSchema: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': type === 'article' ? 'TechArticle' : 'WebPage',
  name: title,
  description,
  url: canonicalUrl,
  isPartOf: {
    '@type': 'WebSite',
    name: siteName,
    url: siteUrl,
    publisher: ORGANIZATION_REF,
  },
};

// The Organization goes first and stands alone, so a consumer looking for
// "who publishes this site" finds it at the top level instead of having to
// walk into WebSite.publisher. Everything else references it by @id.
const pageSchemas: Record<string, unknown>[] = jsonLd
  ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd])
  : [defaultSchema];
const schemas: Record<string, unknown>[] = [ORGANIZATION_JSONLD, ...pageSchemas];
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Tracking (spec 1.3), in this order: consent defaults, attribution.js, GTM. GA4, Google Ads, LinkedIn and X load through GTM. -->
    <script is:inline set:html={CONSENT_DEFAULT_JS} />
    <script is:inline set:html={ATTRIBUTION_JS} />
    <script is:inline set:html={TRACK_JS} />
    <script is:inline set:html={gtmLoaderJs(GTM_ID)} />
    <!-- Full page loads, so one page_view per load (spec 1.3, Astro). -->
    <script is:inline>window.dataLayer.push({event:'page_view',page_location:location.href,page_path:location.pathname,page_title:document.title,page_referrer:document.referrer,page_type:'skills',site_section:location.hostname});</script>

    <!-- Primary -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />

    <!-- Open Graph -->
    <meta property="og:type" content={type === 'article' ? 'article' : 'website'} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:site" content="@40rtyAI" />

    <!-- Favicons -->
    <link rel="icon" type="image/png" href={`${base}40rty-mark.png`} />
    
    <!-- JSON-LD structured data -->
    {schemas.map(schema => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}

  </head>
  <body>
    <noscript><iframe src={`https://www.googletagmanager.com/ns.html?id=${GTM_ID}`} height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <!-- Page-wide gradient mesh -->
    <div class="page-mesh">
      <div class="mesh-orb mesh-1"></div>
      <div class="mesh-orb mesh-2"></div>
      <div class="mesh-orb mesh-3"></div>
    </div>

    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>

<style>
  .page-mesh {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
  }

  .mesh-orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(120px);
    animation: drift 16s ease-in-out infinite;
  }

  .mesh-1 {
    width: 700px;
    height: 700px;
    background: var(--color-accent);
    opacity: 0.25;
    top: -200px;
    right: -150px;
    animation-delay: 0s;
  }

  .mesh-2 {
    width: 500px;
    height: 500px;
    background: var(--color-accent-light);
    opacity: 0.2;
    bottom: 10%;
    left: -100px;
    animation-delay: -6s;
  }

  .mesh-3 {
    width: 400px;
    height: 400px;
    background: var(--color-dark);
    opacity: 0.03;
    top: 40%;
    right: 20%;
    animation-delay: -10s;
  }

  @keyframes drift {
    0%, 100% { transform: translate(0, 0) scale(1); }
    33% { transform: translate(40px, -30px) scale(1.06); }
    66% { transform: translate(-30px, 20px) scale(0.94); }
  }

  body > *:not(.page-mesh) {
    position: relative;
    z-index: 1;
  }

  @media (max-width: 768px) {
    .mesh-1 { width: 400px; height: 400px; }
    .mesh-2 { width: 300px; height: 300px; }
  }
</style>
